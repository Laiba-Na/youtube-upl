generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql" // You can use MySQL or SQLite as well
  url      = env("DATABASE_URL")
}

//team

enum UserType {
  INDIVIDUAL
  TEAM_MEMBER
}

model Team {
  id          String       @id @default(cuid())
  name        String
  description String?
  ownerId     String // The admin/owner of the team
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     TeamMember[]
}

model TeamMember {
  id        String   @id @default(cuid())
  userId    String
  teamId    String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  team      Team     @relation(fields: [teamId], references: [id])

  @@unique([userId, teamId]) // Prevent duplicate team memberships
}

enum Role {
  ADMIN // Full access to everything
  POST_SCHEDULER // Access to POST_CATALOG, CALENDAR, POST_MEDIA
  POST_CREATOR // Access to POST_EDITING
  ANALYTICS // Access to ANALYTICS
  MEMBER // Basic access (customizable)
}

model User {
  id                 String            @id @default(uuid())
  name               String
  email              String            @unique
  password           String
  profileImage       String?
  emailNotifications Boolean           @default(true)
  timezone           String            @default("Asia/Karachi")
  darkMode           Boolean           @default(false)
  analyticsEmails    Boolean           @default(false)
  projects           Project[]
  // Remove fields: googleConnected, googleRefreshToken
  googleAccounts     GoogleAccount[] // one-to-many relationship
  facebookAccounts   FacebookAccount[] // Added relation for Facebook accounts
  posts              Post[] // Added relation for posts
  twoFactorSecret    String? // Store the 2FA secret
  twoFactorEnabled   Boolean           @default(false) // Whether 2FA is enabled
  teamMemberships    TeamMember[] // Add this relation
  userType           UserType          @default(INDIVIDUAL)
  SocialPost         SocialPost[]
}

//google

model GoogleAccount {
  id                String    @id @default(uuid())
  provider          String
  providerAccountId String // Unique identifier provided by Google
  googleEmail       String
  refreshToken      String
  expiresAt         DateTime?
  accessToken       String?
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  createdAt         DateTime  @default(now())
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  content     Json // Stores canvas state
  thumbnail   String? // Path to thumbnail
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  Asset Asset[]
}

model Asset {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String
  url       String
  key       String // e.g. Cloudinary public_id
  filename  String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())
}

model Post {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  scheduledAt DateTime?
  title       String
  description String?
  hashtags    String? // e.g., "tag1,tag2,tag3"
  imageUrl    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model FacebookAccount {
  id                String   @id @default(uuid())
  provider          String
  providerAccountId String
  accessToken       String   @db.Text
  refreshToken      String?  @db.Text
  expiresAt         Int?
  tokenType         String?
  scope             String?  @db.Text
  pageId            String?
  pageName          String?
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  createdAt         DateTime @default(now())
}

model SocialPost {
  id          String   @id @default(uuid())
  userId      String?
  content     String
  platform    String
  scheduledAt DateTime
  mediaUrl    String?
  status      String
  projectId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Platform {
  YOUTUBE
  INSTAGRAM
  LINKEDIN
  FACEBOOK
}

enum Status {
  DRAFT
  SCHEDULED
  POSTED
  NOTIFIED
  FAILED
}
