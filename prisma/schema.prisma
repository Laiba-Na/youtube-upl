generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql" // You can use MySQL or SQLite as well
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(uuid())
  name               String
  email              String    @unique
  profileImage       String?
  emailNotifications Boolean   @default(true)
  timezone           String    @default("Asia/Karachi")
  darkMode           Boolean   @default(false)
  password           String
  projects           Project[]
  analyticsEmails    Boolean   @default(false)

  // Remove fields: googleConnected, googleRefreshToken
  googleAccounts   GoogleAccount[] // one-to-many relationship
  facebookAccounts FacebookAccount[] // Added relation for Facebook accounts
  posts            Post[] // Added relation for posts
  socialPosts      SocialPost[]
}

model GoogleAccount {
  id                String    @id @default(uuid())
  provider          String
  providerAccountId String // Unique identifier provided by Google
  googleEmail       String
  refreshToken      String
  expiresAt         DateTime?
  accessToken       String?
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  createdAt         DateTime  @default(now())
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  content     Json // Stores canvas state
  thumbnail   String? // Path to thumbnail
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  Asset Asset[]
}

model Asset {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String
  url       String
  key       String // e.g. Cloudinary public_id
  filename  String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())
}

model Post {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  title       String
  description String?
  hashtags    String? // e.g., "tag1,tag2,tag3"
  imageUrl    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FacebookAccount {
  id                String    @id @default(uuid())
  provider          String
  providerAccountId String
  accessToken       String    @db.Text
  refreshToken      String?   @db.Text
  expiresAt         DateTime?
  tokenType         String?
  scope             String?   @db.Text
  pageId            String?
  pageName          String?
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  createdAt         DateTime  @default(now())
}

model UserAnalytics {
  userId        String   @id
  username      String
  followers     Int      @default(0)
  following     Int      @default(0)
  profileVisits Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
}

model TweetAnalytics {
  tweetId     String   @id
  likes       Int      @default(0)
  retweets    Int      @default(0)
  impressions Int      @default(0)
  replies     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model SocialPost {
  id      String  @id @default(uuid())
  userId  String?
  content String

  platform    String
  scheduledAt DateTime
  mediaUrl    String?
  status      String
  projectId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Platform {
  YOUTUBE
  INSTAGRAM
  LINKEDIN
  FACEBOOK
}

enum Status {
  DRAFT
  SCHEDULED
  POSTED
  NOTIFIED
  FAILED
}
